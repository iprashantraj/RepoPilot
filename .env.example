# ─── Environment ───────────────────────────────────────────────────────────
REPOPILOT_ENV=development
REPOPILOT_LOG_LEVEL=INFO
REPOPILOT_WEB_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Generate with: openssl rand -hex 32
REPOPILOT_SESSION_SECRET=repopilot-development-session-secret
# Set to true when the API is served over HTTPS in production.
REPOPILOT_SESSION_COOKIE_SECURE=false

# ─── LLM providers ─────────────────────────────────────────────────────────
# Get a free key at https://console.groq.com
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional second fallback before Hugging Face
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

# Hugging Face Inference Providers — final LLM fallback.
# Free user token at https://huggingface.co/settings/tokens (read scope is fine).
# The OpenAI-compatible gateway routes to underlying providers (Cerebras,
# Together, Replicate, etc.) automatically.
HUGGINGFACE_API_KEY=
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1

# Embeddings run **in-process** via fastembed (ONNX, no torch). Weights
# download from huggingface.co into ~/.cache/huggingface on first use
# (~130MB for the `-Q` quantized build). No daemon, no Docker, no HTTP.
# Drop the `-Q` suffix for the full-precision build (~520MB, same 768 dims).
HUGGINGFACE_EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5-Q

# ─── LLM provider behaviour ────────────────────────────────────────────────
LLM_CACHE_PATH=.cache/llm.sqlite
LLM_MAX_429_RETRIES=5
LLM_BACKOFF_BASE_SECONDS=0.5
LLM_BACKOFF_MAX_SECONDS=8.0
LLM_REQUEST_TIMEOUT_SECONDS=60

# Interactive Q&A should fail over quickly in the web UI. Offline/eval paths
# can still opt into compression and the global retry budget directly.
QA_LLM_MAX_429_RETRIES=2
QA_COMPRESS_ENABLED=false

# ─── GitHub (Lane A — Phase 5) ─────────────────────────────────────────────
# Read-only PAT, `public_repo` scope. Shared server-side resource per docs/06 S7.
GITHUB_PAT=

# ─── Datastores ────────────────────────────────────────────────────────────
POSTGRES_DSN=postgresql+psycopg://repopilot:repopilot@localhost:5432/repopilot
# Managed Postgres (Aiven) instead: paste the service URI unchanged — the
# `postgresql://` scheme is rewritten to `postgresql+psycopg://` in code.
# POSTGRES_DSN=postgresql://<user>:<pass>@<name>.aivencloud.com:<port>/defaultdb?sslmode=require
REDIS_URL=redis://localhost:6379/0

# ─── Sign-in (web only, optional) ──────────────────────────────────────────
# With neither AUTH_GOOGLE_ID nor AUTH_GITHUB_ID the app runs anonymously and
# no sign-in is required. With either set, the app is gated: visitors sign in
# first and get a stable session id derived from their account, so their tours
# follow them across devices.
# Callback URLs: <web-origin>/api/auth/callback/{google,github}
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ─── LangSmith (optional observability) ────────────────────────────────────
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=repopilot-dev

LLM_HF_CHAT_FALLBACK=1
