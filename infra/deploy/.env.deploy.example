# Copy to .env.deploy at the repo root and fill in. Never commit it.

# Render — apply render.yaml (repo root) as a Blueprint first, then paste the
# service id (srv-..., from the service URL) and an API key from
# https://dashboard.render.com/u/settings#api-keys.
RENDER_API_KEY=rnd_...
RENDER_SERVICE_ID=srv-...
API_URL=https://repopilot-api.onrender.com

# Postgres with pgvector — Neon or Supabase free tier. Keep the +psycopg tag;
# deploy.sh strips it for psql and the app needs it.
POSTGRES_DSN=postgresql+psycopg://user:pass@host/db?sslmode=require

# Vercel
VERCEL_TOKEN=
VERCEL_PROJECT=repopilot
WEB_URL=https://repopilot.vercel.app

# Secrets — generate with: openssl rand -hex 32
REPOPILOT_SESSION_SECRET=
AUTH_SECRET=

# At least one chat provider is required.
GROQ_API_KEY=
CEREBRAS_API_KEY=
HUGGINGFACE_API_KEY=

# OAuth — whichever providers you enable. Callback URL is
# $WEB_URL/api/auth/callback/<provider>.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional
GITHUB_PAT=
REPOPILOT_LOG_LEVEL=INFO
